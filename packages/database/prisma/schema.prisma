generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  COORDINATOR
  TECHNICIAN
}

enum OrderStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  DELIVERED
  CANCELLED
}

enum EquipmentStatus {
  ACTIVE
  IN_REPAIR
  RETIRED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

model Company {
  id             String   @id @default(uuid())
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  users          User[]
  clients        Client[]
  equipments     Equipment[]
  workOrders     WorkOrder[]
  spareParts     SparePart[]
  workOrderParts WorkOrderPart[]
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  password    String
  name        String
  role        Role     @default(TECHNICIAN)
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workOrders  WorkOrder[]

  @@index([companyId])
}

model Client {
  id          String   @id @default(uuid())
  name        String
  email       String?
  phone       String?
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  equipments  Equipment[]

  @@index([companyId])
}

model Equipment {
  id           String          @id @default(uuid())
  brand        String
  model        String
  serialNumber String?
  qrCode       String          @unique @default(uuid())
  status       EquipmentStatus @default(ACTIVE)
  clientId     String
  client       Client          @relation(fields: [clientId], references: [id])
  companyId    String
  company      Company         @relation(fields: [companyId], references: [id])
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  workOrders   WorkOrder[]

  @@index([companyId])
  @@index([clientId])
}

model WorkOrder {
  id          String      @id @default(uuid())
  description String
  diagnosis   String?
  status      OrderStatus @default(PENDING)
  priority    Priority    @default(MEDIUM)
  equipmentId String
  equipment   Equipment   @relation(fields: [equipmentId], references: [id])
  userId      String?
  user        User?       @relation(fields: [userId], references: [id])
  companyId   String
  company     Company     @relation(fields: [companyId], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  parts       WorkOrderPart[]

  @@index([companyId])
  @@index([equipmentId])
  @@index([userId])
}

model SparePart {
  id             String   @id @default(uuid())
  sku            String
  name           String
  description    String?
  stock          Int      @default(0)
  minStock       Int      @default(0)
  cost           Decimal  @db.Decimal(12, 2)
  salePrice      Decimal  @db.Decimal(12, 2)
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  workOrderParts WorkOrderPart[]

  @@unique([companyId, sku])
  @@index([companyId])
}

model WorkOrderPart {
  id          String    @id @default(uuid())
  quantity    Int
  unitCost    Decimal   @db.Decimal(12, 2)
  unitPrice   Decimal   @db.Decimal(12, 2)
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id])
  sparePartId String
  sparePart   SparePart @relation(fields: [sparePartId], references: [id])
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([workOrderId, sparePartId])
  @@index([companyId])
  @@index([workOrderId])
  @@index([sparePartId])
}
