generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  COORDINATOR
  TECHNICIAN
}

enum OrderStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  DELIVERED
  CANCELLED
}

enum EquipmentStatus {
  ACTIVE
  IN_REPAIR
  RETIRED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
}

enum PaymentMethod {
  CASH
  TRANSFER
  CHECK
  CARD
  OTHER
}

enum ServiceType {
  CORRECTIVE
  PREVENTIVE
  INSPECTION
  INSTALLATION
}

/// Sin EXPIRED a propósito: el vencimiento se DERIVA al leer (SENT +
/// validUntil pasada), nunca se guarda — ver QuotesService.isExpired.
enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

enum ActivityAction {
  ORDER_CREATED
  STATUS_CHANGED
  TECHNICIAN_ASSIGNED
  PRIORITY_CHANGED
  DIAGNOSIS_UPDATED
  OBSERVATIONS_UPDATED
  DESCRIPTION_UPDATED
  EQUIPMENT_LINKED
  EQUIPMENT_UNLINKED
  PART_ADDED
  PART_REMOVED
  PHOTO_ADDED
  PHOTO_REMOVED
  BILLING_UPDATED
  BILLED_AT_CHANGED
  COLLECTION_DOC_GENERATED
  PAYMENT_REGISTERED
  PAYMENT_DELETED
  MAINTENANCE_UPDATED
}

model Company {
  id                    String               @id @default(uuid())
  name                  String
  slogan                String?
  /// NIT (u otro documento tributario) de la empresa — distinto de
  /// payeeDocument, que es el documento del BENEFICIARIO del pago (puede
  /// ser una persona o razón social distinta). Aparece en el membrete de
  /// los documentos imprimibles (ej. cotización).
  taxId                 String?
  phone                 String?
  email                 String?
  address               String?
  website               String?
  /// URL del logo del tenant (Cloudinary). Aún sin flujo de carga: llega
  /// en una iteración posterior.
  logoUrl               String?
  /// Moneda del tenant para formatear precios (ver DTO: COP/USD/EUR/MXN/PEN).
  currency              String               @default("COP")
  /// Contador atómico por tenant para asignar WorkOrder.orderNumber consecutivo.
  nextOrderNumber       Int                  @default(1)
  /// Porcentaje de IVA del tenant (ej. 19.00). 0 si no es responsable de IVA.
  taxRate               Decimal              @default(0) @db.Decimal(5, 2)
  /// Título configurable del documento de cobro (ej. "Cuenta de cobro", "Recibo de caja").
  collectionDocTitle    String               @default("Cuenta de cobro")
  /// Beneficiario del pago en el documento — puede diferir de Company.name
  /// (ej. cuenta a nombre de otra persona/razón social). Sin valor: se usa
  /// el nombre de la empresa como beneficiario por defecto.
  payeeName             String?
  payeeDocument         String?
  bankName              String?
  bankAccount           String?
  /// Nombre y cargo de quien firma el documento de cobro.
  signerName            String?
  signerRole            String?
  /// Nota al pie del documento de cobro; el frontend aplica un texto por
  /// defecto ("no equivale a factura electrónica...") cuando está vacía.
  collectionDocFootnote String?
  /// Contador atómico por tenant para el consecutivo de cuentas de cobro
  /// (WorkOrder.collectionNumber), mismo patrón que nextOrderNumber.
  nextCollectionNumber  Int                  @default(1)
  /// Contador atómico por tenant para el consecutivo de cotizaciones
  /// (Quote.quoteNumber) — mismo patrón, pero se consume al ENVIAR, no al
  /// crear (ver QuotesService.send): un borrador abandonado no quema número.
  nextQuoteNumber       Int                  @default(1)
  /// Condiciones comerciales por defecto de una cotización nueva. Se
  /// COPIAN a cada Quote al crearla (no se referencian): una cotización ya
  /// enviada debe conservar las condiciones con que se envió aunque estos
  /// valores cambien después — mismo principio que congelar unitPrice en
  /// WorkOrderPart.
  defaultPaymentTerms   String?
  defaultDeliveryTime   String?
  defaultWarrantyTerms  String?
  defaultExclusions     String?
  defaultValidityDays   Int                  @default(30)
  /// Días tras el envío para sugerir Quote.followUpAt.
  quoteFollowUpDays     Int                  @default(5)
  /// Nota al pie del documento de cotización (entrega 2 — vista imprimible).
  quoteFootnote         String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  users                 User[]
  clients               Client[]
  equipments            Equipment[]
  workOrders            WorkOrder[]
  spareParts            SparePart[]
  workOrderParts        WorkOrderPart[]
  attachments           Attachment[]
  payments              Payment[]
  workOrderEquipment    WorkOrderEquipment[]
  activityLogs          ActivityLog[]
  quotes                Quote[]
  quoteItems            QuoteItem[]
  quoteEquipment        QuoteEquipment[]
}

model User {
  id                 String        @id @default(uuid())
  email              String        @unique
  password           String
  name               String
  role               Role          @default(TECHNICIAN)
  /// true = la contraseña actual fue asignada por un tercero (alta de
  /// empresa o restablecimiento por un administrador) y el usuario debe
  /// cambiarla antes de poder usar el sistema.
  mustChangePassword Boolean       @default(false)
  companyId          String
  company            Company       @relation(fields: [companyId], references: [id])
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  workOrders         WorkOrder[]
  /// Fotos que este usuario subió a órdenes; sobrevive a su eliminación
  /// (uploadedById queda en null, la foto y su orden no se tocan).
  attachments        Attachment[]
  /// Pagos que este usuario registró; sobrevive a su eliminación
  /// (registeredById queda en null, el pago no se toca).
  payments           Payment[]
  /// Eventos de bitácora de los que este usuario fue autor; sobrevive a su
  /// eliminación (userId queda en null, ActivityLog.userName conserva el
  /// nombre como snapshot).
  activityLogs       ActivityLog[]
  /// Cotizaciones que este usuario creó; sobrevive a su eliminación
  /// (createdById queda en null, la cotización no se toca).
  quotesCreated      Quote[]

  @@index([companyId])
}

model Client {
  id              String      @id @default(uuid())
  name            String
  email           String?
  phone           String?
  /// CC, NIT, CE o PASAPORTE — validado en el DTO, no como enum de BD
  /// para no requerir migración si aparecen otros tipos de documento.
  documentType    String?
  documentNumber  String?
  address         String?
  city            String?
  /// Días de crédito acordados con el cliente (ej. 30 = "pago a 30 días").
  paymentTermDays Int         @default(30)

  /// Formato de informe propio del cliente (Módulo de Formatos): cuando este
  /// cliente exige que las órdenes se entreguen en SU formato corporativo
  /// (típico al trabajar como subcontratista de una empresa con sistema de
  /// gestión de calidad). GENÉRICO a propósito — no se programa "el formato
  /// de Fire Energy", se configuran estos campos por cliente. Ver
  /// /ordenes/[id]/formato-cliente en el frontend.
  reportFormatEnabled     Boolean @default(false)
  /// Obligatorio si reportFormatEnabled=true (validado en el DTO). Ej. "ORDEN DE SERVICIO".
  reportFormatTitle       String?
  reportFormatCode        String?
  reportFormatVersion     String?
  /// Texto libre (ej. "28/09/2019"): es la fecha de la VERSIÓN del formato
  /// impreso, no una fecha operativa — se muestra tal cual la escribe quien
  /// configura, sin parsear ni validar como fecha real.
  reportFormatDate        String?
  reportFormatLogoUrl     String?
  /// Color hexadecimal de las franjas de sección del documento.
  reportFormatAccentColor String?
  reportFormatFooter      String?
  /// Empresa que figura como quien ENTREGA el informe en el bloque de firmas.
  reportFormatIssuer      String?
  /// Tres secciones configurables: etiqueta + de qué campo de la orden se
  /// alimenta (DESCRIPTION | DIAGNOSIS | OBSERVATIONS | EMPTY — validado en
  /// el DTO, no enum de BD por el mismo motivo que documentType).
  reportFormatS1Label     String?
  reportFormatS1Source    String?
  reportFormatS2Label     String?
  reportFormatS2Source    String?
  reportFormatS3Label     String?
  reportFormatS3Source    String?

  companyId       String
  company         Company     @relation(fields: [companyId], references: [id])
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  equipments      Equipment[]
  workOrders      WorkOrder[]
  quotes          Quote[]

  @@index([companyId])
  @@index([companyId, documentNumber])
}

model Equipment {
  id                        String               @id @default(uuid())
  brand                     String
  model                     String
  serialNumber              String?
  /// Ubicación física del equipo en la sede del cliente (ej. "CC La Cuesta,
  /// Piedecuesta — Local AME2170 Americanino"). Un cliente puede tener
  /// varias sedes; este campo identifica dónde está instalado ESTE equipo.
  location                  String?
  qrCode                    String               @unique @default(uuid())
  status                    EquipmentStatus      @default(ACTIVE)
  /// Plan de mantenimiento preventivo — la alerta es POR EQUIPO, cada
  /// aparato tiene su propio ciclo (ver módulo de mantenimiento).
  maintenanceEnabled        Boolean              @default(false)
  /// 1..60 (validado en el DTO). Obligatorio si maintenanceEnabled=true.
  maintenanceIntervalMonths Int?
  /// Fecha del último mantenimiento, SE GUARDA explícitamente (no se
  /// deduce de la última orden preventiva): al activar el plan de un
  /// cliente con historial previo al sistema, hay que poder escribir esa
  /// fecha aunque nunca haya pasado por una orden acá. Semántica de FECHA
  /// sin hora (@db.Date) — evita desfases de un día por zona horaria.
  lastMaintenanceAt         DateTime?            @db.Date
  /// Calculada como lastMaintenanceAt + maintenanceIntervalMonths y
  /// GUARDADA (no derivada al vuelo) para que la consulta del panel de
  /// vencimientos pueda usar el índice de abajo. Se recalcula cada vez que
  /// cambia el intervalo o la última fecha. Semántica de FECHA sin hora.
  nextMaintenanceAt         DateTime?            @db.Date
  clientId                  String
  client                    Client               @relation(fields: [clientId], references: [id])
  companyId                 String
  company                   Company              @relation(fields: [companyId], references: [id])
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
  /// Órdenes en las que participa este equipo — vía la tabla intermedia
  /// WorkOrderEquipment: una orden puede tener varios equipos y un equipo
  /// puede aparecer en varias órdenes.
  workOrderEquipment        WorkOrderEquipment[]
  /// Cotizaciones en las que participa este equipo — mismo patrón, vía
  /// QuoteEquipment.
  quoteEquipment            QuoteEquipment[]

  @@index([companyId])
  @@index([clientId])
  /// Alimenta GET /equipments/maintenance-due, consultado en cada carga
  /// del panel de mantenimientos por vencer.
  @@index([companyId, nextMaintenanceAt])
}

model WorkOrder {
  id                    String               @id @default(uuid())
  /// Consecutivo legible por tenant (ej. OT-0001). Asignado atómicamente
  /// desde Company.nextOrderNumber al crear la orden.
  orderNumber           Int
  description           String
  diagnosis             String?
  /// Notas del servicio realizado, separadas del diagnóstico inicial.
  observations          String?
  /// Recomendaciones al cliente (ej. "cambiar el filtro cada 3 meses"),
  /// separadas de `observations` (notas de LO QUE SE HIZO). Alimenta la
  /// sección SUGGESTIONS del formato de informe propio del cliente y, si
  /// tiene contenido, un bloque propio en el informe de la empresa.
  suggestions           String?
  /// CORRECTIVE por defecto: valor honesto para las órdenes existentes al
  /// introducir este campo (nadie sabía que eran inspecciones) — el
  /// usuario corrige las que en realidad lo fueron.
  serviceType           ServiceType          @default(CORRECTIVE)
  status                OrderStatus          @default(PENDING)
  priority              Priority             @default(MEDIUM)
  /// Mano de obra cobrada en la orden.
  laborAmount           Decimal              @default(0) @db.Decimal(12, 2)
  /// Cargos adicionales (transporte u otros), con su descripción.
  additionalAmount      Decimal              @default(0) @db.Decimal(12, 2)
  additionalDescription String?
  discountAmount        Decimal              @default(0) @db.Decimal(12, 2)
  /// Congelados al pasar la orden a COMPLETED: a partir de ese momento el
  /// total no se recalcula aunque cambien precios del inventario o el IVA
  /// de la empresa — misma lógica de integridad contable que unitCost/
  /// unitPrice en WorkOrderPart.
  taxRateApplied        Decimal?             @db.Decimal(5, 2)
  totalAmount           Decimal?             @db.Decimal(12, 2)
  /// Costo del trabajo que NO proviene del inventario: torno, materiales
  /// comprados para la obra, subcontratos, consumibles. NUNCA se le cobra
  /// al cliente ni entra en ningún total facturado — existe solo para
  /// calcular el margen real (módulo de Rentabilidad). A diferencia del
  /// resto del cierre económico, SÍ es editable después de cerrada la
  /// orden, solo por ADMIN (igual que billedAt): la factura del proveedor
  /// suele llegar días después de entregado el trabajo.
  directCostAmount      Decimal              @default(0) @db.Decimal(12, 2)
  directCostDescription String?
  billedAt              DateTime?
  paymentStatus         PaymentStatus        @default(PENDING)
  /// Consecutivo por tenant de la cuenta de cobro emitida sobre esta orden
  /// (ver Company.nextCollectionNumber). Null hasta que se genera el
  /// documento — solo se puede generar una vez por orden.
  collectionNumber      Int?
  collectionIssuedAt    DateTime?
  /// Cliente FINAL del servicio, cuando la empresa trabaja como
  /// subcontratista (ej. TAELCO para Fire Energy): `client`/`clientId` es
  /// quien CONTRATA (a quien se le factura), pero en el formato de informe
  /// propio del cliente contratante la casilla "Cliente" se refiere al
  /// destinatario real del servicio. Opcional — vacío, la línea sale en
  /// blanco para llenarla a mano (ver /ordenes/[id]/formato-cliente).
  endClientName         String?
  /// Ciudad donde se ejecutó ESTE servicio — puede diferir de la ciudad
  /// registrada en la ficha del cliente (ej. cliente con sede en
  /// Bucaramanga, servicio prestado en otra ciudad). Si está vacía, el
  /// formato de informe propio del cliente usa Client.city como respaldo.
  serviceCity           String?
  /// Cliente dueño de la orden — vínculo principal. Toda orden pertenece a
  /// un cliente; los equipos son opcionales y pueden ser varios (ver
  /// equipmentLinks) — cero equipos es un servicio locativo.
  clientId              String
  client                Client               @relation(fields: [clientId], references: [id])
  userId                String?
  user                  User?                @relation(fields: [userId], references: [id])
  companyId             String
  company               Company              @relation(fields: [companyId], references: [id])
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  parts                 WorkOrderPart[]
  attachments           Attachment[]
  payments              Payment[]
  /// Equipos intervenidos en esta orden (0, 1 o varios) — tabla intermedia
  /// porque una orden puede abarcar varios equipos del mismo cliente (ej.
  /// un proyecto de adecuación sobre 5 portones cotizado como una sola OT).
  equipmentLinks        WorkOrderEquipment[]
  activityLogs          ActivityLog[]

  @@unique([companyId, orderNumber])
  @@unique([companyId, collectionNumber])
  @@index([companyId])
  @@index([clientId])
  @@index([userId])
  /// Filtros de GET /work-orders y agregados del dashboard/cartera.
  @@index([companyId, status])
  @@index([companyId, priority])
  @@index([companyId, billedAt])
  @@index([companyId, paymentStatus])
}

model SparePart {
  id             String          @id @default(uuid())
  sku            String
  name           String
  description    String?
  /// REPUESTO, EQUIPO, MATERIAL o CONSUMIBLE — validado en el DTO, no como
  /// enum de BD (mismo patrón que Client.documentType).
  category       String          @default("REPUESTO")
  stock          Int             @default(0)
  minStock       Int             @default(0)
  /// false = artículo que se pide contra pedido y no se mantiene en
  /// bodega: no entra en alertas de existencias y su stock no se mueve al
  /// usarlo en una orden.
  trackStock     Boolean         @default(true)
  cost           Decimal         @db.Decimal(12, 2)
  salePrice      Decimal         @db.Decimal(12, 2)
  companyId      String
  company        Company         @relation(fields: [companyId], references: [id])
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  workOrderParts WorkOrderPart[]
  /// Ítems de cotización que se prellenaron desde este repuesto (solo
  /// referencia para prellenar descripción/precio — ver QuoteItem). Una
  /// cotización NUNCA mueve inventario.
  quoteItems     QuoteItem[]

  @@unique([companyId, sku])
  @@index([companyId])
}

model WorkOrderPart {
  id          String    @id @default(uuid())
  quantity    Int
  unitCost    Decimal   @db.Decimal(12, 2)
  unitPrice   Decimal   @db.Decimal(12, 2)
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id])
  sparePartId String
  sparePart   SparePart @relation(fields: [sparePartId], references: [id])
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([workOrderId, sparePartId])
  @@index([companyId])
  @@index([workOrderId])
  @@index([sparePartId])
}

/// Fotos adjuntas a una orden de trabajo (evidencia del servicio), alojadas
/// en Cloudinary. `publicId` es el identificador remoto necesario para
/// poder borrar el archivo cuando se elimina el adjunto.
model Attachment {
  id           String    @id @default(uuid())
  url          String
  publicId     String
  workOrderId  String
  workOrder    WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id])
  uploadedById String?
  uploadedBy   User?     @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())

  @@index([companyId])
  @@index([workOrderId])
}

/// Abono registrado contra una orden de trabajo. El módulo de cartera
/// (siguiente entrega) se apoya en esta tabla para calcular saldos; por
/// ahora solo se registra el pago — WorkOrder.paymentStatus se actualiza
/// en el mismo flujo.
model Payment {
  id             String        @id @default(uuid())
  workOrderId    String
  workOrder      WorkOrder     @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  companyId      String
  company        Company       @relation(fields: [companyId], references: [id])
  amount         Decimal       @db.Decimal(12, 2)
  paidAt         DateTime
  method         PaymentMethod
  reference      String?
  notes          String?
  registeredById String?
  registeredBy   User?         @relation(fields: [registeredById], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())

  @@index([companyId])
  @@index([workOrderId])
  /// Rango "cobrado del mes" (paidAt dentro del mes actual).
  @@index([companyId, paidAt])
}

/// Bitácora de auditoría de la orden: quién la modificó, qué cambió y
/// cuándo. Tabla de SOLO INSERCIÓN — no hay update ni delete individual; el
/// único borrado posible es en cascada al eliminar la orden completa (ver
/// onDelete: Cascade en workOrderId). No confundir con el historial de
/// órdenes de la ficha del equipo, que es otra cosa.
model ActivityLog {
  id          String         @id @default(uuid())
  companyId   String
  company     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workOrderId String
  workOrder   WorkOrder      @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  /// Autor del evento. SetNull para no perder el registro si se elimina el usuario.
  userId      String?
  user        User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Snapshot del nombre del autor al momento del evento: sobrevive al borrado
  /// del usuario y al cambio de nombre. La bitácora debe leerse igual dentro de
  /// dos años.
  userName    String
  action      ActivityAction
  /// Etiqueta legible del campo afectado, cuando aplica (ej. "Mano de obra").
  field       String?
  oldValue    String?
  newValue    String?
  /// Marca el evento como financiero AL ESCRIBIRLO. Es el filtro que aplica el
  /// backend para el rol TECHNICIAN — así la regla vive en el dato y no hay que
  /// mantener una lista de acciones sensibles en el frontend.
  isFinancial Boolean        @default(false)
  createdAt   DateTime       @default(now())

  @@index([companyId])
  @@index([workOrderId, createdAt])
}

/// Tabla intermedia orden↔equipo: una orden puede tener cero (servicio
/// locativo), uno o varios equipos del mismo cliente (ej. un proyecto de
/// adecuación normativa sobre 5 portones cotizado y cobrado como una sola
/// orden). onDelete: Cascade en workOrderId — al borrar la orden desaparecen
/// sus vínculos; equipmentId sin onDelete (Restrict, igual que antes) — no
/// se puede borrar un equipo que sigue referenciado en alguna orden.
model WorkOrderEquipment {
  id          String    @id @default(uuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id])
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])
  createdAt   DateTime  @default(now())

  @@unique([workOrderId, equipmentId])
  @@index([companyId])
  @@index([workOrderId])
  /// GET /work-orders?equipmentId= — el @@unique de arriba no sirve para
  /// buscar por equipmentId solo (workOrderId es la columna líder).
  @@index([equipmentId])
}

/// Propuesta comercial enviada a un cliente. NO es un estado de WorkOrder:
/// ciclo propio (DRAFT → SENT → ACCEPTED/REJECTED), numeración propia
/// (quoteNumber, asignado al ENVIAR, no al crear) y la mayoría nunca se
/// convierte en trabajo — mezclarla con WorkOrder habría forzado un estado
/// "cotizando" ajeno al ciclo real de una orden de trabajo.
model Quote {
  id                String           @id @default(uuid())
  companyId         String
  company           Company          @relation(fields: [companyId], references: [id])
  clientId          String
  client            Client           @relation(fields: [clientId], references: [id])
  /// Consecutivo legible por tenant (ej. COT-0001). null mientras está en
  /// DRAFT — se asigna atómicamente desde Company.nextQuoteNumber recién
  /// al enviar (ver QuotesService.send), así un borrador abandonado no
  /// quema número. @@unique de abajo permite muchos null (un borrador no
  /// choca con otro) porque Postgres no compara NULLs como iguales — mismo
  /// patrón que WorkOrder.collectionNumber.
  quoteNumber       Int?
  /// Asunto de la cotización (ej. "Suministro e instalación de motores").
  title             String
  /// Sede o proyecto del cliente al que aplica, cuando aplica.
  siteName          String?
  /// Alcance del trabajo propuesto — texto largo.
  scope             String
  status            QuoteStatus      @default(DRAFT)
  discountAmount    Decimal          @default(0) @db.Decimal(12, 2)
  /// Congelados al ENVIAR (igual que WorkOrder.taxRateApplied/totalAmount):
  /// a partir de SENT el total no se recalcula aunque cambien los precios
  /// del inventario o el IVA de la empresa. En DRAFT se calculan al vuelo.
  taxRateApplied    Decimal?         @db.Decimal(5, 2)
  subtotalAmount    Decimal?         @db.Decimal(12, 2)
  totalAmount       Decimal?         @db.Decimal(12, 2)
  /// Condiciones comerciales — copiadas de Company.default* al crear (ver
  /// modelo Company), editables mientras sigue en DRAFT.
  paymentTerms      String?
  deliveryTime      String?
  warrantyTerms     String?
  exclusions        String?
  /// Días de validez de la oferta desde que se envía. Copiado de
  /// Company.defaultValidityDays al crear.
  validityDays      Int
  /// sentAt + validityDays, calculado y guardado al enviar. Semántica de
  /// FECHA sin hora (@db.Date) — igual criterio que el módulo de
  /// mantenimiento preventivo: "vence el 12" no puede leerse "el 11" según
  /// la zona horaria.
  validUntil        DateTime?        @db.Date
  sentAt            DateTime?
  /// Sugerida como sentAt + Company.quoteFollowUpDays al enviar; editable
  /// después (es lo único, junto al estado, que se puede tocar tras SENT).
  followUpAt        DateTime?        @db.Date
  decidedAt         DateTime?
  /// Obligatorio cuando status pasa a REJECTED (validado en el service) —
  /// sin esto no hay forma de saber después si se perdió por precio, por
  /// tiempo de entrega o por falta de seguimiento.
  rejectionReason   String?
  /// Orden de inspección de origen, si la hubo. Referencia suelta (sin FK)
  /// a propósito: la conversión cotización→orden llega en la entrega 2.
  sourceWorkOrderId String?
  createdById       String?
  createdBy         User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  items             QuoteItem[]
  equipmentLinks    QuoteEquipment[]

  @@unique([companyId, quoteNumber])
  @@index([companyId])
  @@index([companyId, status])
}

/// Línea de una cotización — SIEMPRE texto libre (ver `description`).
/// sparePartId es puramente opcional: solo sirve para prellenar
/// descripción y precio desde el inventario; una vez creada la fila es
/// independiente del catálogo. Cotizar es describir un proyecto (equipos,
/// materiales, mano de obra, servicios de terceros), no listar repuestos en
/// stock. NUNCA descuenta inventario — eso ocurre al ejecutar el trabajo,
/// no al proponerlo.
model QuoteItem {
  id          String     @id @default(uuid())
  companyId   String
  company     Company    @relation(fields: [companyId], references: [id])
  quoteId     String
  quote       Quote      @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  /// Orden de despliegue de la fila en el documento.
  position    Int
  description String
  quantity    Decimal    @db.Decimal(12, 2)
  unitPrice   Decimal    @db.Decimal(12, 2)
  /// Solo para prellenar (ver arriba). SetNull si el repuesto se elimina
  /// del inventario más adelante: la fila ya tiene su propia descripción y
  /// precio copiados, no depende de que el repuesto siga existiendo.
  sparePartId String?
  sparePart   SparePart? @relation(fields: [sparePartId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([quoteId])
}

/// Tabla intermedia cotización↔equipo — mismo patrón que
/// WorkOrderEquipment: una cotización puede abarcar 0, 1 o varios equipos
/// del mismo cliente.
model QuoteEquipment {
  id          String    @id @default(uuid())
  quoteId     String
  quote       Quote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id])
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])
  createdAt   DateTime  @default(now())

  @@unique([quoteId, equipmentId])
  @@index([companyId])
  @@index([quoteId])
  @@index([equipmentId])
}
