generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  COORDINATOR
  TECHNICIAN
}

enum OrderStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  DELIVERED
  CANCELLED
}

enum EquipmentStatus {
  ACTIVE
  IN_REPAIR
  RETIRED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

model Company {
  id              String          @id @default(uuid())
  name            String
  slogan          String?
  phone           String?
  email           String?
  address         String?
  website         String?
  /// URL del logo del tenant (Cloudinary). Aún sin flujo de carga: llega
  /// en una iteración posterior.
  logoUrl         String?
  /// Moneda del tenant para formatear precios (ver DTO: COP/USD/EUR/MXN/PEN).
  currency        String          @default("COP")
  /// Contador atómico por tenant para asignar WorkOrder.orderNumber consecutivo.
  nextOrderNumber Int             @default(1)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  users           User[]
  clients         Client[]
  equipments      Equipment[]
  workOrders      WorkOrder[]
  spareParts      SparePart[]
  workOrderParts  WorkOrderPart[]
  attachments     Attachment[]
}

model User {
  id          String       @id @default(uuid())
  email       String       @unique
  password    String
  name        String
  role        Role         @default(TECHNICIAN)
  companyId   String
  company     Company      @relation(fields: [companyId], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  workOrders  WorkOrder[]
  /// Fotos que este usuario subió a órdenes; sobrevive a su eliminación
  /// (uploadedById queda en null, la foto y su orden no se tocan).
  attachments Attachment[]

  @@index([companyId])
}

model Client {
  id             String      @id @default(uuid())
  name           String
  email          String?
  phone          String?
  /// CC, NIT, CE o PASAPORTE — validado en el DTO, no como enum de BD
  /// para no requerir migración si aparecen otros tipos de documento.
  documentType   String?
  documentNumber String?
  address        String?
  companyId      String
  company        Company     @relation(fields: [companyId], references: [id])
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  equipments     Equipment[]

  @@index([companyId])
  @@index([companyId, documentNumber])
}

model Equipment {
  id           String          @id @default(uuid())
  brand        String
  model        String
  serialNumber String?
  qrCode       String          @unique @default(uuid())
  status       EquipmentStatus @default(ACTIVE)
  clientId     String
  client       Client          @relation(fields: [clientId], references: [id])
  companyId    String
  company      Company         @relation(fields: [companyId], references: [id])
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  workOrders   WorkOrder[]

  @@index([companyId])
  @@index([clientId])
}

model WorkOrder {
  id           String          @id @default(uuid())
  /// Consecutivo legible por tenant (ej. OT-0001). Asignado atómicamente
  /// desde Company.nextOrderNumber al crear la orden.
  orderNumber  Int
  description  String
  diagnosis    String?
  /// Notas del servicio realizado, separadas del diagnóstico inicial.
  observations String?
  status       OrderStatus     @default(PENDING)
  priority     Priority        @default(MEDIUM)
  equipmentId  String
  equipment    Equipment       @relation(fields: [equipmentId], references: [id])
  userId       String?
  user         User?           @relation(fields: [userId], references: [id])
  companyId    String
  company      Company         @relation(fields: [companyId], references: [id])
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  parts        WorkOrderPart[]
  attachments  Attachment[]

  @@unique([companyId, orderNumber])
  @@index([companyId])
  @@index([equipmentId])
  @@index([userId])
}

model SparePart {
  id             String          @id @default(uuid())
  sku            String
  name           String
  description    String?
  /// REPUESTO, EQUIPO, MATERIAL o CONSUMIBLE — validado en el DTO, no como
  /// enum de BD (mismo patrón que Client.documentType).
  category       String          @default("REPUESTO")
  stock          Int             @default(0)
  minStock       Int             @default(0)
  cost           Decimal         @db.Decimal(12, 2)
  salePrice      Decimal         @db.Decimal(12, 2)
  companyId      String
  company        Company         @relation(fields: [companyId], references: [id])
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  workOrderParts WorkOrderPart[]

  @@unique([companyId, sku])
  @@index([companyId])
}

model WorkOrderPart {
  id          String    @id @default(uuid())
  quantity    Int
  unitCost    Decimal   @db.Decimal(12, 2)
  unitPrice   Decimal   @db.Decimal(12, 2)
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id])
  sparePartId String
  sparePart   SparePart @relation(fields: [sparePartId], references: [id])
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([workOrderId, sparePartId])
  @@index([companyId])
  @@index([workOrderId])
  @@index([sparePartId])
}

/// Fotos adjuntas a una orden de trabajo (evidencia del servicio), alojadas
/// en Cloudinary. `publicId` es el identificador remoto necesario para
/// poder borrar el archivo cuando se elimina el adjunto.
model Attachment {
  id           String    @id @default(uuid())
  url          String
  publicId     String
  workOrderId  String
  workOrder    WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id])
  uploadedById String?
  uploadedBy   User?     @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())

  @@index([companyId])
  @@index([workOrderId])
}
