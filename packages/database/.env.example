# Copia este archivo a .env. Los valores de abajo ya apuntan a la base
# LOCAL de Docker (ver docker-compose.yml en la raíz) — no hace falta
# cambiarlos para desarrollar.
#
# Producción vive SOLO en Supabase, configurada desde las variables de
# Railway — NUNCA en un .env de este repo, ni de ejemplo ni real.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fixtrack_dev"

# development | production. En Railway esta variable se configura como
# 'production'. Los scripts destructivos (seed-dev, reset-pilot) se niegan
# a correr si esto no dice 'development' — ver scripts/guards.ts.
APP_ENV=development
