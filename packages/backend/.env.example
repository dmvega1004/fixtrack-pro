# Copia este archivo a .env y completa los valores reales.
# En Railway, estas mismas variables se configuran en el dashboard del
# servicio (Settings -> Variables), NUNCA en un archivo .env commiteado.

# Connection string de Postgres. En desarrollo apunta a la base LOCAL de
# Docker (ver docker-compose.yml en la raíz del repo):
#   postgresql://postgres:postgres@localhost:5432/fixtrack_dev
# Producción vive SOLO en Supabase, configurada desde las variables de
# Railway — NUNCA en un .env de este repo. Requerida.
DATABASE_URL=

# development | production. En Railway esta variable se configura como
# 'production'. Los scripts destructivos del paquete database (seed-dev,
# reset-pilot) se niegan a correr si esto no dice 'development'.
APP_ENV=development

# Secreto usado para firmar los JWT de sesión. Requerida, sin valor por
# defecto — el backend falla al arrancar si falta (ver auth.module.ts).
# Genera uno fuerte, por ejemplo: openssl rand -base64 48
JWT_SECRET=

# Duración del token, formato aceptado por la librería `ms` (ej. 8h, 30m, 7d).
# Opcional — si no se define, el backend usa "8h" por defecto.
JWT_EXPIRES_IN=8h

# Origen exacto del frontend (usado para CORS). En desarrollo apunta al
# Next.js local; en producción, la URL de Vercel del frontend.
# Opcional en desarrollo (fallback http://localhost:3001) — REQUERIDA en
# producción, sin fallback seguro para ese entorno.
FRONTEND_URL=http://localhost:3001

# Credenciales de la cuenta de Cloudinary (fotos de OT y logo del tenant).
# Requeridas.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Puerto en el que escucha el servidor. Opcional — Railway lo inyecta
# automáticamente en tiempo de ejecución; en desarrollo local por defecto
# es 3000 si no se define.
PORT=3000

# Clave que exige POST /auth/register (cabecera x-provisioning-key) para
# dar de alta una empresa nueva. La conoce SOLO el operador de la
# plataforma — no hay pantalla de registro en el frontend, así que esto
# es de uso interno/manual. Sin esta variable el endpoint queda
# COMPLETAMENTE DESHABILITADO (responde 403 siempre, sin importar la
# cabecera que se envíe) — nunca la trates como opcional en producción.
# Genera una con: openssl rand -base64 48
# Trátala como una contraseña: no se comparte, no entra a Git, no se pega
# en ningún chat. Ver DEPLOY.md, sección "Alta de una empresa nueva".
PROVISIONING_KEY=
